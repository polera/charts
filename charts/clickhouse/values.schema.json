{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ClickHouse chart values",
  "type": "object",
  "properties": {
    "ha": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "clickhouse": {
      "type": "object",
      "properties": {
        "clusterName": { "type": "string", "minLength": 1 },
        "shards": { "type": "integer", "minimum": 1 },
        "replicasPerShard": { "type": "integer", "minimum": 1 }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "admin": {
          "type": "object",
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "allowedNetworks": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "databases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "databases"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "password": { "type": "string" },
          "databases": { "type": "array", "items": { "type": "string" } },
          "allowedNetworks": { "type": "array", "items": { "type": "string" } },
          "profile": { "type": "string" },
          "quota": { "type": "string" }
        }
      }
    },
    "keeper": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "type": "string", "enum": ["native", "clickhouse-backup"] },
        "schedule": { "type": "string" },
        "destination": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["s3", "gcs", "path"] }
          }
        },
        "clickhouseBackup": {
          "type": "object",
          "properties": {
            "remoteStorage": { "type": "string", "enum": ["s3", "gcs"] },
            "apiPort": { "type": "integer", "minimum": 1 },
            "s3": {
              "type": "object",
              "properties": {
                "auth": { "type": "string", "enum": ["keys", "iam"] }
              }
            },
            "gcs": {
              "type": "object",
              "properties": {
                "auth": { "type": "string", "enum": ["key", "workloadIdentity"] }
              }
            }
          }
        }
      }
    }
  }
}
